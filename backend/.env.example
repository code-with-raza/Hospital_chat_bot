# ── LLM settings ──────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# For Groq, set LLM_PROVIDER=groq, use your Groq API key, and choose a model
# listed at https://console.groq.com/docs/models.
# LLM_PROVIDER=groq
# LLM_API_KEY=your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# ── Embedding settings ─────────────────────────────────────────────────────
# Local sentence-transformers model (runs offline, no API key needed).
# Change to any model from https://www.sbert.net/docs/pretrained_models.html
EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_MODEL=all-mpnet-base-v2          # higher quality, larger
# EMBEDDING_MODEL=all-MiniLM-L12-v2          # moderate quality/speed
